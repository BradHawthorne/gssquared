{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-local",
                "-G",
                "Ninja",
                "-DGS2_PROGRAM_FILES=ON",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build-local",
                    "-G",
                    "Ninja",
                    "-DGS2_PROGRAM_FILES=ON",
                    "-DCMAKE_BUILD_TYPE=Debug",
                    "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe",
                    "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "configure-release",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-local",
                "-G",
                "Ninja",
                "-DGS2_PROGRAM_FILES=ON",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build-local",
                    "-G",
                    "Ninja",
                    "-DGS2_PROGRAM_FILES=ON",
                    "-DCMAKE_BUILD_TYPE=Release",
                    "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe",
                    "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "configure-release-with-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-local",
                "-G",
                "Ninja",
                "-DGS2_PROGRAM_FILES=ON",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build-local",
                    "-G",
                    "Ninja",
                    "-DGS2_PROGRAM_FILES=ON",
                    "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                    "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe",
                    "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "problemMatcher": []
        },
        {
            "label": "build-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-local",
                "--parallel"
            ],
            "dependsOn": "configure-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-gs2-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-local",
                "--parallel",
                "--target",
                "GSSquared"
            ],
            "dependsOn": "configure-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-gs2-debug-win",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-local",
                "--parallel",
                "--target",
                "GSSquared"
            ],
            "dependsOn": "configure-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "group": {
                "kind": "build",
