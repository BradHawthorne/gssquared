            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-cycletest-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-local",
                "--parallel",
                "--target",
                "cycletest"
            ],
            "dependsOn": "configure-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-local",
                "--parallel"
            ],
            "dependsOn": "configure-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-release-with-debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-local",
                "--parallel"
            ],
            "dependsOn": "configure-release-with-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/cmake.exe",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "profile-with-instruments",
            "type": "shell",
            "command": "xcrun xctrace record --template 'CPU Profiler' --no-prompt --output /tmp/mmutest_profile_$(date +%Y%m%d_%H%M%S).trace --target-stdout - --launch -- ${workspaceFolder}/build-local/mmutest && open /tmp/mmutest_profile_*.trace",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "profile-gssquared-with-instruments",
            "type": "shell",
            "command": "xcrun xctrace record --template 'CPU Profiler' --no-prompt --output /tmp/gssquared_profile_$(date +%Y%m%d_%H%M%S).trace --target-stdout - --launch -- ${workspaceFolder}/build-local/GSSquared && open /tmp/gssquared_profile_*.trace",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "profile-mmutest-manual",
            "type": "shell",
            "command": "xcrun xctrace record --template 'CPU Profiler' --no-prompt --output /tmp/mmutest_profile_$(date +%Y%m%d_%H%M%S).trace --target-stdout - --launch -- ${workspaceFolder}/build-local/mmutest",
            "group": "test",
            "presentation": {
