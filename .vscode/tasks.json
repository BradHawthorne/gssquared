            }
        },
        {
            "label": "profile-gssquared-manual",
            "type": "shell",
            "command": "xcrun xctrace record --template 'CPU Profiler' --no-prompt --output /tmp/gssquared_profile_$(date +%Y%m%d_%H%M%S).trace --target-stdout - --launch -- ${workspaceFolder}/build-local/GSSquared",
