{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug gs2",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-local/GSSquared",
            "args": [
                "-p",
                "5"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-gs2-debug",
            "windows": {
                "program": "${workspaceFolder}/build-local/GSSquared.exe",
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            }
        },
